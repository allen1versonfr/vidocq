{
  "manifest_version": 3,
  "name": "Vidocq Reviewed Evidence",
  "version": "1.0.0",
  "description": "Capture selected public text and links as a local JSON file for Vidocq.",
  "permissions": ["activeTab", "scripting"],
  "action": {"default_popup": "popup.html", "default_title": "Capture reviewed evidence"},
  "browser_specific_settings": {"gecko": {"id": "reviewed-evidence@vidocq.local", "data_collection_permissions": {"required": ["none"]}}}
}
